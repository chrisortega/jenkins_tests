pipeline {
    agent any

    environment {
        IMAGE_NAME   = 'local-fastapi-app'
        IMAGE_TAG    = 'latest'
        CONTAINER_ID = 'fastapi-app'
        NETWORK_NAME = 'jenkins_default' 
    }

    stages {
        // ❌ Removed the checkout stage because your code is already local
        
        stage('Build Docker Image') {
            steps {
                echo "Building fresh FastAPI image: ${IMAGE_NAME}:${IMAGE_TAG}..."
                // Adjust the directory path if Jenkins needs to step into a specific folder
                sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} /src"
            }
        }

        stage('Run Pytest') {
            steps {
                echo 'Running unit tests...'
                sh "docker run --rm ${IMAGE_NAME}:${IMAGE_TAG} pytest"
            }
        }

        stage('Deploy Container') {
            steps {
                echo 'Deploying container...'
                sh "docker stop ${CONTAINER_ID} || true"
                sh "docker rm ${CONTAINER_ID} || true"
                sh "docker run -d \
                    --name ${CONTAINER_ID} \
                    -p 8000:8000 \
                    --network ${NETWORK_NAME} \
                    --restart unless-stopped \
                    ${IMAGE_NAME}:${IMAGE_TAG}"
            }
        }
    }

    post {
        always {
            sh 'docker image prune -f'
        }
    }
}
